# SightEngine API Credentials (Required for content safety analysis)
# Sign up at https://sightengine.com/ to get your API user and secret
VITE_SIGHTENGINE_USER=your_sightengine_api_user
VITE_SIGHTENGINE_SECRET=your_sightengine_api_secret

# Google Custom Search API (Optional: used for matching web sources discovery)
# Set up at https://developers.google.com/custom-search/v1/overview
VITE_GOOGLE_API_KEY=your_google_custom_search_api_key
VITE_GOOGLE_CX=your_google_custom_search_engine_cx

